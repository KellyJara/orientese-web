# Copia este archivo a .env y pon tu propia clave.
# APIs que deben estar habilitadas en Google Cloud:
#   Maps JavaScript API · Places API · Directions API · Geocoding API
VITE_GOOGLE_API_KEY=tu-clave-de-google

# Map ID para los marcadores avanzados. DEMO_MAP_ID sirve en desarrollo.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
